{
  "name": "fixitpro-agent",
  "version": "1.0.0",
  "description": "FixITPro Cash Drawer Agent - opens cash drawer via USB or Network printer",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg src/index.js --targets node18-win-x64 --output dist/FixITPro-Agent.exe --compress GZip"
  },
  "pkg": {
    "assets": ["src/**/*"],
    "outputPath": "dist"
  },
  "dependencies": {},
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
