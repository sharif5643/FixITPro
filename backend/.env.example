# App
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fixitpro_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis — optional แต่แนะนำใน production เพื่อ module cache ข้าม instance
# REDIS_URL=redis://localhost:6379
# ถ้าไม่ตั้ง: ใช้ in-memory fallback (ใช้ได้ถ้ารัน single container)

# Super Admin (ใช้กับ npm run seed:superadmin เท่านั้น)
SUPER_ADMIN_EMAIL=superadmin@fixitpro.com
SUPER_ADMIN_PASSWORD=change_this_password
SUPER_ADMIN_NAME=Super Admin
